{
  "manifest_version": 3,
  "name": "Slacker",
  "version": "1.2.0",
  "description": "Telegram-style checks on your Slack messages. Seen works when the other person also uses Slacker.",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "*://*.slack.com/*",
    "*://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Slacker"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.slack.com/*",
        "*://app.slack.com/*"
      ],
      "js": ["page-inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.slack.com/*",
        "*://app.slack.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
